# Use independent, long random secrets. Do not commit the real .env file.
GAME_SAVE_TOKEN=replace-with-a-long-random-sync-token
GAME_SAVE_ADMIN_TOKEN=replace-with-a-different-long-random-admin-token

# Optional OpenSave WebDAV credentials. Set both to enable the separate /opensave/ endpoint.
# Do not reuse the sync or administrator token here.
GAME_SAVE_OPENSAVE_USERNAME=opensave
GAME_SAVE_OPENSAVE_PASSWORD=replace-with-a-third-long-random-secret

# Bind to loopback by default. Use the NAS private address for LAN clients;
# never use 0.0.0.0 for a LAN-only service.
GAME_SAVE_BIND_ADDRESS=127.0.0.1
GAME_SAVE_PORT=8788
GAME_SAVE_DATA_DIR=/volume1/docker/game-save/data
GAME_SAVE_IMAGE=jun9100/game-save:v1.0.0

# Optional snapshot retention defaults (0 = unlimited). Once changed in the dashboard,
# the dashboard value stored in data/settings.json takes precedence.
GAME_SAVE_KEEP_SNAPSHOTS=0
GAME_SAVE_KEEP_DAYS=0

# Dashboard timestamps use the browser's time zone; TZ only affects server logs.
TZ=Asia/Shanghai

# Set these to the owner UID/GID of GAME_SAVE_DATA_DIR on the NAS.
PUID=10001
PGID=10001
