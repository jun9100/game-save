[Unit]
Description=Game Save synchronization service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=game-save
Group=game-save
EnvironmentFile=/etc/game-save.env
ExecStart=/usr/local/bin/game-save --data-dir /var/lib/game-save --listen 127.0.0.1:8787
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/game-save

[Install]
WantedBy=multi-user.target
